# Server Configuration
NODE_ENV=development
PORT=4000

# Database Configuration
DATABASE_PATH=./behavioural_hub.db

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key-change-this
JWT_REFRESH_EXPIRES_IN=7d

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security
BCRYPT_ROUNDS=10

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log

# Email Configuration (SendGrid)
EMAIL_ENABLED=false
SENDGRID_API_KEY=your-sendgrid-api-key
EMAIL_FROM=noreply@behavioural-hub.com
EMAIL_FROM_NAME=Behavioural Hub

# Slack Notifications (optional)
SLACK_ENABLED=false
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your-webhook-url

# Error Tracking (Sentry)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=development

# API Documentation
SWAGGER_ENABLED=true

# Admin User (for initial setup)
ADMIN_EMAIL=admin@behavioural-hub.com
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=System Administrator
